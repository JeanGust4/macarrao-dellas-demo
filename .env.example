# Execute npm run setup para criar credenciais locais aleatorias.
DEMO_MODE=true
SESSION_SECRET=
MANAGER_EMAIL=
MANAGER_PASSWORD_HASH=
# Opcional: banco remoto libSQL. Deixe vazio para usar SQLite local.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# O envio real fica desligado por padrao, inclusive com credenciais.
WHATSAPP_LIVE=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=
# Opcional. Sem chave, o assistente usa regras locais, indicado na interface.
OPENAI_API_KEY=
OPENAI_MODEL=
